# Copie para .env.local e preencha. Nunca versione .env.local.
#
# Valores PÚBLICOS (vão para o navegador; a proteção dos dados é feita pela RLS no banco).
# Desenvolvimento local: use os valores exibidos por `npm run db:start` / `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública do site (links de confirmação e retorno do login). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Exibe o botão "Continuar com Google". Ligar ("true") somente após configurar o
# provedor Google no Supabase (local: supabase/config.toml; remoto: painel do Supabase).
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# Valores SECRETOS (somente servidor; nunca prefixar com NEXT_PUBLIC_).
# Não utilizados no fluxo normal da aplicação — ver docs/ARQUITETURA.md, seção 5.2.
# SUPABASE_SECRET_KEY=

# Credenciais do Google para o Supabase LOCAL (lidas pelo supabase/config.toml):
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
